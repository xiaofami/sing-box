{
  "version": 1,
  "rules": [
    {
      "domain": [
        "googlevideo.com",
        "dl.google.com",
        "dl.l.google.com",
        "update.googleapis.com"
      ],
      "domain_suffix": [
        "googlevideo.com",
        "c.youtube.com",
        "gvt1.com",
        "gvt2.com",
        "gvt3.com",
        "gvt1-cn.com",
        "gvt2-cn.com"
      ],
      "domain_regex": [
        "^r[0-9]+---sn-[a-z0-9]+\\.googlevideo\\.com$",
        "^r[0-9]+---sn-[a-z0-9]+\\.c\\.youtube\\.com$",
        "^r+[0-9]+(---|\\.)sn-(2x3|ni5|j5o)\\w{5}\\.googlevideo\\.com$"
      ]
    }
  ]
}